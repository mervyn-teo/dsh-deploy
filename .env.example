# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Required for public deployment ---
# Public hostname pointing at this host, e.g. dsh.example.com.
# Enables automatic HTTPS (Let's Encrypt) and dsh's trusted-host allowlist.
# Leave as ":80" for local testing (plain HTTP, no TLS).
DSH_DOMAIN=:80

# Basic auth protecting the GUI. MANDATORY on any public deployment:
# dsh has no built-in auth and can execute shell commands.
DSH_AUTH_USER=admin
DSH_AUTH_PASSWORD=change-me-to-a-long-random-string

# Optional: extra Host authority for dsh's browser-trust fence, e.g. a bare
# public IP when serving plain HTTP without a domain. Usually leave empty —
# a real DSH_DOMAIN is allowlisted automatically.
DSH_TRUSTED_HOST=

# --- Provider credentials ---
# Written to /data/.credentials.yaml on first boot (dsh's managed credential
# store); also visible to providers via `apiKeyEnv` in $DSH_HOME/settings.yaml.
# The seeded settings.yaml references these; add more as needed.
DEEPSEEK_API_KEY=
KIMI_CODING_API_KEY=
